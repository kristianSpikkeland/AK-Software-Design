@inherits LayoutComponentBase
@inject GameNightState GameNight

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GameNight.LoadAsync();
        }
    }
}