@page "/games/{Id:int}"
@inject Data.GamesStorageAndQuery gamesQuery
@inject GameNightState GameNight
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IDisposable

@if (game is not null)
{
	<h1>Detaljer</h1>
	<p>Id: @game.Id</p>
	<p>Navn: @game.Name</p>
	<p>Kategori: @game.Category</p>
	<p>Minimum spillere: @game.MinPlayers</p>
	<p>Maksimum spillere: @game.MaxPlayers</p>
	<p>Beskrivelse: @game.Description</p>
	<br />

	<GameNightButton Game="game"
                     IsSelected="GameNight.Contains(game.Id)"
                     OnAdd="HandleAdd"
                     OnRemove="HandleRemove" />
	
	@* Adding message to user if game was added to game night*@
	@if (message is not null)
    {
        <p>@message</p>
    }

	<DiceRating BoardGame="game" @key="game.Id" ReadOnly="false" />

	<EditForm Model="@game" OnValidSubmit="Save" FormName="game-form">
		<DataAnnotationsValidator />
		<label>Ditt terningkast: </label><InputNumber @bind-Value="game.Rating" />
		<ValidationMessage For="() => game.Rating" />
		<button type="submit">Lagre vurdering</button>
	</EditForm>
	<br />	
}

else
{
	<p>Spill ikke funnet</p>
}

<button @onclick="GoBack">Til oversikt</button>

@code {
	[Parameter] public int Id { get; set; }

	private BoardGame? game;

	private IEnumerable<BoardGame> games = [];


	protected override void OnInitialized()
	=> GameNight.OnChange += OnGameNightChanged;

	private void OnGameNightChanged() => InvokeAsync(StateHasChanged);

	protected override async Task OnParametersSetAsync()
	{
		game = await gamesQuery.GetGameByIdAsync(Id);

		if (game is null)
		{
			Nav.NotFound();
		}
	}

	private void GoBack() => Nav.NavigateTo("/games");

	public void Save()
	{
		// await GameApi.CreateAsync(game);
	}



	private string? message;

	private async Task HandleAdd(BoardGame g)
	{
		message = await GameNight.AddAsync(g) ? "Spillet ble lagt til" : "Spillet er allerede lagt til";
		StateHasChanged();

		await Task.Delay(3000);
		message = null;
	}

	private async Task HandleRemove(BoardGame g) => GameNight.RemoveAsync(g.Id);

	public void Dispose() => GameNight.OnChange -= OnGameNightChanged;

}
