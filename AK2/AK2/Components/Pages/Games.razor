@page "/games";
@inject Data.GamesStorageAndQuery gamesQuery;
@inject GameNightState GameNight
@rendermode InteractiveServer


<h3>Brettspill</h3>
<GameBadge />

<div class="search-box">
	<input type="search" autofocus @bind="nameFilter" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Navn / antall spillere"
</div>

@if(filteredGames.Count() < 1)
{
	<p style="color:red">Ingen treff</p>	
}


@foreach (var game in filteredGames)
{
	<GameCard BoardGame="game" @key="game.Id" OnAdd="HandleAdd" />
	<p><a href="/games/@game.Id">Detaljer</a></p>

	@if (message is not null)
	{
		<p>@message</p>
	}
	<br />
}



<p>Antall treff: @filteredGames.Count()</p>


<button @onclick="ShowRandomGame">Tilfeldig spill</button>

@if (randomGame != null)
{
	<p>@randomGame.Name</p>
}




@code {
	private IEnumerable<BoardGame> games = [];
	[Parameter] public BoardGame? game { get; set; }
	string nameFilter = string.Empty;

	public BoardGame? randomGame;


	// Using StringComparison.CurrentCultureIgnoreCase to allow both uppercase and lowercase letters
	IEnumerable<BoardGame> filteredGames = [];

	protected override void OnInitialized() => ApplyFilter();

	private void ApplyFilter()
	{
		filteredGames = gamesQuery.FilterGames(nameFilter).ToList();
	}


	private void ShowRandomGame()
	{
		randomGame = gamesQuery.GetRandomGame();
	}


	// Code to eunsure user that game was added
	private string? message;

    private async Task HandleAdd(BoardGame game)
    {
		GameNight.Add();
        message = "Spillet ble lagt til";
        await Task.Delay(3000);
        message = null;
    }
}
