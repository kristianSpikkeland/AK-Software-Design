@page "/games";
@inject Data.GamesStorageAndQuery gamesQuery;
@rendermode InteractiveServer


<h3>Games</h3>

<div class="search-box">
	<input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Name..."
</div>

<table border="1" cellpadding="8">
	<thead>
		<tr>
			<th>Id</th>
			<th>Navn</th>
			<th>Minimum spillere</th>
			<th>Maksimum spillere</th>
		</tr>
	</thead>

	<tbody>
		@foreach (var game in FilterdItems)
		{
			<tr>
				<td>@game.Id</td>
				<td>@game.Name</td>
				<td>@game.MinPlayers</td>
				<td>@game.MaxPlayers</td>
			</tr>
		}
	</tbody>

</table>

@code {
	private IEnumerable<BoardGame> games = [];
	string nameFilter = string.Empty;

	// Using StringComparison.CurrentCultureIgnoreCase to allow both uppercase and lowercase letters
	IEnumerable<BoardGame>? FilterdItems => games.Where(games => games.Name.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase));

	protected override void OnInitialized()
	{
		games = gamesQuery.GetAllGames();
	}
}
